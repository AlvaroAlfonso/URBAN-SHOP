{
    "name": "Urban & Shop",
    "short_name": "UrbanShop",
    "description": "Moda urbana transformada. Descubre las últimas tendencias con un enfoque sostenible, pagina SPA informatviva y con integracion de tienda onnline  .",
    "lang": "es-ES",
    "start_url": "/index.html",
    "background_color": "#000000",
    "theme_color": "#0D8BB9",
    "display": "standalone",
    "display_override": ["window-controls-overlay"],
    "edge_side_panel": {
    "enabled": true,
    "preferred_width": 400
  },
    "orientation": "portrait",
    "icons": [
      {
        "src": "/Assets/images/Logo192x192.png",
        "sizes": "192x192",
        "type": "image/png"
      },
      {
        "src": "/Assets/images/Logo512x512.png",
        "sizes": "512x512",
        "type": "image/png"
      }
    ],
    "screenshots": [
      {
        "src": "/Assets/images/Logo640x1136.png",
        "sizes": "640x1136",
        "type": "image/png"
      },
      {
        "src": "/Assets/images/Logo400x400.png",
        "sizes": "640x1136",
        "type": "image/png"
      }
    ],
    "protocol_handlers": [
  {
    "protocol": "web+UrbanShop",
    "url": "./?cmd=%s"
  }
]
}